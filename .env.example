# Copy to .env.local (or set in Vercel > Project > Settings > Environment Variables).
# Everything is optional: each tag loads only when its ID is set.

# Where qualifying-form leads are POSTed as JSON (GoHighLevel inbound webhook,
# Zapier catch hook, etc.). Server-only; never exposed to the browser.
LEAD_WEBHOOK_URL=

# Meta Pixel. Fires PageView, Lead (form) and Schedule (Calendly booking)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads. ID looks like AW-123456789; labels come from each conversion action
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=

# LinkedIn Insight Tag + conversion IDs
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
NEXT_PUBLIC_LINKEDIN_BOOKING_CONVERSION_ID=
